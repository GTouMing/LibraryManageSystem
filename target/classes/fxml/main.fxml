<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="github.gtouming.library.controller.MainController"
            styleClass="main-container">

    <!-- 主内容区域 -->
    <BorderPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <!-- 左侧导航栏 -->
        <left>
            <VBox styleClass="sidebar">
                <!-- 侧边栏头部 -->
                <VBox styleClass="sidebar-header">
                    <Label text="图书馆管理系统" styleClass="sidebar-title"/>
                </VBox>

                <!-- 导航按钮 -->
                <VBox VBox.vgrow="ALWAYS">
                    <Button fx:id="borrowBtn" text="借阅管理" styleClass="nav-button"
                            maxWidth="Infinity" prefHeight="50"/>
                    <Button fx:id="personalBtn" text="个人信息" styleClass="nav-button"
                            maxWidth="Infinity" prefHeight="50"/>
                    <Button fx:id="readerBtn" text="读者管理" styleClass="nav-button"
                            maxWidth="Infinity" prefHeight="50"/>
                    <Button fx:id="bookBtn" text="图书管理" styleClass="nav-button"
                            maxWidth="Infinity" prefHeight="50"/>
                </VBox>

                <!-- 底部退出按钮 -->
                <Button fx:id="logoutBtn" text="退出登录" styleClass="nav-button"
                        maxWidth="Infinity" prefHeight="50"/>
            </VBox>
        </left>

        <!-- 主内容区域 -->
        <center>
            <StackPane fx:id="contentPane" styleClass="content-pane">
                <!-- 内容将通过代码动态加载 -->
            </StackPane>
        </center>
    </BorderPane>

    <!-- 顶部拖动区域 -->
    <Pane fx:id="dragRegion" styleClass="drag-region"
        AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

    <!-- 确认卡片 -->
    <HBox alignment="TOP_CENTER" AnchorPane.topAnchor="8"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               pickOnBounds="false">
        <HBox fx:id="confirmBar" alignment="CENTER" spacing="4"
              styleClass="confirm-bar" visible="false" managed="false">
            <Label fx:id="confirmLabel" styleClass="confirm-label"/>
            <Button fx:id="confirmOkBtn" text="✓" styleClass="btn-small"
                    visible="false" managed="false"/>
            <Button fx:id="confirmCancelBtn" text="✗" styleClass="btn-small"
                    visible="false" managed="false"/>
        </HBox>
    </HBox>
    <!-- 窗口控制按钮 -->
    <HBox AnchorPane.topAnchor="8" AnchorPane.rightAnchor="8" spacing="4" alignment="CENTER_RIGHT">
        <Button fx:id="minBtn" text="─" styleClass="window-button-mini"/>
        <Button fx:id="maxBtn" text="□" styleClass="window-button-mini"/>
        <Button fx:id="closeBtn" text="✕" styleClass="window-button-mini"/>
    </HBox>
</AnchorPane>
