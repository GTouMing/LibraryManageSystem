<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="github.gtouming.library.controller.LoginController"
            styleClass="login-pane">

    <!-- 登录内容 -->
    <VBox alignment="CENTER" spacing="30" styleClass="login-container" 
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Label text="图书馆管理系统" styleClass="title-label"/>

        <VBox spacing="15" alignment="CENTER">
            <HBox spacing="15" alignment="CENTER">
                <Label text="账号：" styleClass="input-label"/>
                <TextField fx:id="usernameField" promptText="请输入账号" styleClass="text-field"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <Label text="密码：" styleClass="input-label"/>
                <PasswordField fx:id="passwordField" promptText="请输入密码" styleClass="password-field"/>
            </HBox>
        </VBox>

        <HBox spacing="30" alignment="CENTER">
            <Button fx:id="loginButton" text="登录" styleClass="primary-button"/>
            <Button fx:id="registerButton" text="注册" styleClass="secondary-button"/>
        </HBox>
    </VBox>
    <!-- 顶部拖动区域 -->
    <Pane fx:id="dragRegion" styleClass="drag-region"
        AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

    <!-- 确认卡片 -->
    <HBox alignment="TOP_CENTER" AnchorPane.topAnchor="8"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               pickOnBounds="false">
        <HBox fx:id="confirmBar" alignment="CENTER" spacing="4"
              styleClass="confirm-bar" visible="false" managed="false">
            <Label fx:id="confirmLabel" styleClass="confirm-label"/>
            <Button fx:id="confirmOkBtn" text="✓" styleClass="btn-small"
                    visible="false" managed="false"/>
            <Button fx:id="confirmCancelBtn" text="✗" styleClass="btn-small"
                    visible="false" managed="false"/>
        </HBox>
    </HBox>

    <!-- 窗口控制按钮 -->
    <HBox AnchorPane.topAnchor="8" AnchorPane.rightAnchor="8" spacing="4" alignment="CENTER_RIGHT">
        <Button fx:id="minBtn" text="─" styleClass="window-button-mini"/>
        <Button fx:id="maxBtn" text="□" styleClass="window-button-mini"/>
        <Button fx:id="closeBtn" text="✕" styleClass="window-button-mini"/>
    </HBox>
</AnchorPane>
