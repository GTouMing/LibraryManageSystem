<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="github.gtouming.library.controller.PersonalController"
      styleClass="content-area" spacing="24">

    <!-- 头部 -->
    <VBox styleClass="content-header">
        <Label text="个人信息" styleClass="content-title"/>
        <Label text="查看和管理个人资料" styleClass="content-subtitle"/>
    </VBox>

    <!-- 个人信息卡片 -->
    <VBox styleClass="card" spacing="20">
        <Label text="基本信息" styleClass="card-title"/>

        <GridPane hgap="24" vgap="16">
            <Label text="账号：" styleClass="form-label"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="accountField" editable="false" styleClass="text-field"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="昵称：" styleClass="form-label"
                   GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="nameField" styleClass="text-field"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="性别：" styleClass="form-label"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <HBox spacing="12" alignment="CENTER_LEFT"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <RadioButton fx:id="maleRadio" text="男"/>
                <RadioButton fx:id="femaleRadio" text="女"/>
            </HBox>

            <Label text="地区：" styleClass="form-label"
                   GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <ComboBox fx:id="regionCombo" promptText="请选择地区" styleClass="combo-box"
                      GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        </GridPane>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="saveBtn" text="保存修改" styleClass="primary-button"/>
            <Button fx:id="changePwdBtn" text="修改密码" styleClass="secondary-button"/>
            <Button fx:id="deleteBtn" text="注销账号" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <!-- 统计信息 -->
    <HBox spacing="16">
        <VBox styleClass="stat-card">
            <Label text="借阅次数" styleClass="stat-label"/>
            <Label fx:id="borrowCountLabel" text="0" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card">
            <Label text="当前借阅" styleClass="stat-label"/>
            <Label fx:id="currentBorrowLabel" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

</VBox>
