<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="github.gtouming.library.controller.BorrowController"
      styleClass="content-area" spacing="24">

    <!-- 头部 -->
    <VBox styleClass="content-header">
        <Label text="借阅管理" styleClass="content-title"/>
        <Label fx:id="headerSubtitle" text="管理图书借阅和归还" styleClass="content-subtitle"/>
    </VBox>

    <HBox HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="搜索图书或借阅记录" styleClass="search-field"/>
        <Button fx:id="borrowBtn" text="借阅选中" styleClass="secondary-button"/>
        <Button fx:id="deleteBtn" text="删除记录" styleClass="secondary-button"/>
        <Button fx:id="returnBtn" text="强制归还" styleClass="secondary-button"/>
    </HBox>
    <!-- 借阅记录（标签页） -->
    <TabPane fx:id="borrowTabPane" VBox.vgrow="ALWAYS">
        <Tab fx:id="borrowTab" text="借阅图书" closable="false">
            <TableView fx:id="borrowTable">
                <columns>
                    <TableColumn text="图书号" fx:id="bookIdCol"/>
                    <TableColumn text="书名" fx:id="titleCol"/>
                    <TableColumn text="作者" fx:id="authorCol"/>
                    <TableColumn text="出版社" fx:id="publisherCol"/>
                    <TableColumn text="复本数" fx:id="copyCountCol"/>
                    <TableColumn text="可用数" fx:id="availableCountCol"/>
                </columns>
            </TableView>
        </Tab>
        <Tab text="借阅记录" closable="false">
            <TableView fx:id="historyTable">
                <columns>
                    <TableColumn text="读者" fx:id="historyReaderCol"/>
                    <TableColumn text="图书号" fx:id="historyBookIdCol"/>
                    <TableColumn text="书名" fx:id="historyTitleCol"/>
                    <TableColumn text="借阅日期" fx:id="historyBorrowDateCol"/>
                    <TableColumn text="归还日期" fx:id="historyReturnDateCol"/>
                    <TableColumn text="状态" fx:id="historyStatusCol"/>
                </columns>
            </TableView>
        </Tab>
    </TabPane>

</VBox>
