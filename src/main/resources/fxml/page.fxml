<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="github.gtouming.library.controller.PageController"
            styleClass="page-pane">

    <VBox alignment="CENTER" spacing="24" styleClass="page-container"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Label fx:id="formTitle" text="读者注册" styleClass="title-label"/>

        <GridPane fx:id="formGrid" hgap="16" vgap="14" alignment="CENTER"/>

        <HBox spacing="30" alignment="CENTER">
            <Button fx:id="submitBtn" text="注册" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <!-- 顶部拖动区域 -->
    <Pane fx:id="dragRegion" styleClass="drag-region"
        AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

    <!-- 确认卡片 -->
    <HBox alignment="TOP_CENTER" AnchorPane.topAnchor="8"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               pickOnBounds="false">
        <HBox fx:id="confirmBar" alignment="CENTER" spacing="4"
              styleClass="confirm-bar" visible="false" managed="false">
            <Label fx:id="confirmLabel" styleClass="confirm-label"/>
            <Button fx:id="confirmOkBtn" text="✓" styleClass="btn-small"
                    visible="false" managed="false"/>
            <Button fx:id="confirmCancelBtn" text="✗" styleClass="btn-small"
                    visible="false" managed="false"/>
        </HBox>
    </HBox>

    <!-- 窗口控制按钮 -->
    <HBox AnchorPane.topAnchor="8" AnchorPane.rightAnchor="8" spacing="4" alignment="CENTER_RIGHT">
        <Button fx:id="closeBtn" text="✕" styleClass="window-button-mini"/>
    </HBox>
</AnchorPane>
