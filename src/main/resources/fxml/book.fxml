<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="github.gtouming.library.controller.BookManageController"
      styleClass="content-area" spacing="24">

    <!-- 头部 -->
    <VBox styleClass="content-header">
        <Label text="图书管理" styleClass="content-title"/>
        <Label text="管理图书馆的图书信息" styleClass="content-subtitle"/>
    </VBox>

    <!-- 搜索和操作 -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="搜索图书号、书名或作者" styleClass="search-field"/>
        <Button fx:id="addBookBtn" text="添加图书" styleClass="secondary-button"/>
        <Button fx:id="updateBookBtn" text="修改图书" styleClass="secondary-button"/>
        <Button fx:id="deleteBookBtn" text="删除图书" styleClass="secondary-button"/>
    </HBox>

    <!-- 图书列表 -->
    <TabPane VBox.vgrow="ALWAYS">
        <Tab text="图书列表" closable="false">
            <TableView fx:id="bookTable">
                <columns>
                    <TableColumn text="图书号" fx:id="bookIdCol"/>
                    <TableColumn text="书名" fx:id="titleCol"/>
                    <TableColumn text="作者" fx:id="authorCol"/>
                    <TableColumn text="分类" fx:id="categoryCol"/>
                    <TableColumn text="出版社" fx:id="publisherCol"/>
                    <TableColumn text="复本数" fx:id="copyCountCol"/>
                    <TableColumn text="可用数" fx:id="availableCountCol"/>
                </columns>
            </TableView>
        </Tab>
    </TabPane>
</VBox>
